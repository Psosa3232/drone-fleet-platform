# ============================================
# Drone Fleet Platform - Configuration Template
# ============================================
# Copy this file to application.properties and fill in your actual credentials.
# NEVER commit application.properties with real credentials to version control.

# PostgreSQL Database Configuration
spring.datasource.url=jdbc:postgresql://YOUR_DB_HOST:YOUR_DB_PORT/YOUR_DB_NAME
spring.datasource.username=YOUR_DB_USERNAME
spring.datasource.password=YOUR_DB_PASSWORD
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect

# Redis Cache Configuration
spring.cache.type=redis
spring.data.redis.host=YOUR_REDIS_HOST
spring.data.redis.port=YOUR_REDIS_PORT
spring.cache.redis.time-to-live=3600000